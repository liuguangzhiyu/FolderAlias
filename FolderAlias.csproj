<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>FolderAlias</AssemblyName>
    <RootNamespace>FolderAlias</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\FolderAlias.ico</ApplicationIcon>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Xml" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Compile Include="src\Native.cs" /><Compile Include="src\IniDocument.cs" />
    <Compile Include="src\AliasEngine.cs" /><Compile Include="src\MenuIntegration.cs" />
    <Compile Include="src\MainForm.cs" /><Compile Include="src\Program.cs" />
    <Compile Include="src\FolderPicker.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
